{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "functions": {
    "api/index.ts": {
      "runtime": "@vercel/node@5.7.15",
      "includeFiles": [
        "node_modules/.prisma/**",
        "node_modules/@prisma/client/**",
        "prisma/schema.prisma"
      ]
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ]
}
